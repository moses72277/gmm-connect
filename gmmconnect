<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>GMM Connect - Facebook Style</title>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-storage-compat.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:SF Pro,Segoe UI,Roboto}
body{background:#f0f2f5}
header{position:sticky;top:0;z-index:100;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:8px 16px;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.logo{font-size:28px;font-weight:900;color:#0866ff;letter-spacing:-1px}
.search{background:#f0f2f5;border-radius:50px;padding:10px 15px;width:240px;display:flex;align-items:center;gap:8px}
.search input{border:none;background:transparent;outline:none;width:100%}
.nav-mid{display:flex;gap:10px}
.nav-mid i{font-size:22px;padding:10px 30px;border-radius:8px;cursor:pointer;color:#65676b}
.nav-mid i.active{color:#0866ff;border-bottom:3px solid #0866ff;border-radius:0}
.right{display:flex;align-items:center;gap:10px}
.right i{background:#e4e6eb;padding:10px;border-radius:50%;cursor:pointer}
#loginScreen{position:fixed;inset:0;background:#f0f2f5;display:flex;align-items:center;justify-content:center;z-index:200}
.login-box{background:#fff;padding:30px;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.15);text-align:center;width:90%;max-width:400px}
.login-box h1{color:#0866ff;font-size:42px;margin-bottom:10px}
.btn{background:#0866ff;color:#fff;border:none;padding:12px 20px;border-radius:8px;width:100%;font-size:16px;font-weight:600;cursor:pointer;margin-top:15px}
.main{display:grid;grid-template-columns:280px 1fr 280px;gap:20px;max-width:1400px;margin:20px auto;padding:0 10px}
.card{background:#fff;border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,.1);padding:12px;margin-bottom:15px}
.create{display:flex;gap:10px;align-items:center}
.create img{width:40px;height:40px;border-radius:50%}
.create input{background:#f0f2f5;border:none;border-radius:20px;padding:10px 15px;width:100%;outline:none;cursor:pointer}
.post-head{display:flex;gap:10px;align-items:center;margin-bottom:10px}
.post-head img{width:40px;height:40px;border-radius:50%}
.post-actions{display:flex;justify-content:space-around;border-top:1px solid #ddd;margin-top:10px;padding-top:8px}
.post-actions span{cursor:pointer;padding:8px 20px;border-radius:8px;color:#65676b}
.post-actions span:hover{background:#f0f2f5}
.feed-img{width:100%;border-radius:8px;margin-top:10px;max-height:500px;object-fit:cover}
.chat-box{position:fixed;bottom:0;right:20px;width:330px;background:#fff;border-radius:10px 10px 0 0;box-shadow:0 -2px 15px rgba(0,0,0,.2);display:none;flex-direction:column;height:400px;z-index:150}
.chat-head{background:#0084ff;color:#fff;padding:10px;display:flex;justify-content:space-between;border-radius:10px 10px 0 0}
.messages{flex:1;overflow-y:auto;padding:10px;display:flex;flex-direction:column;gap:8px}
.msg{background:#f0f2f5;padding:8px 12px;border-radius:18px;max-width:80%;align-self:flex-start}
.msg.me{background:#0084ff;color:#fff;align-self:flex-end}
.chat-input{display:flex;padding:8px;border-top:1px solid #eee}
.chat-input input{flex:1;border:none;background:#f0f2f5;border-radius:20px;padding:10px 15px;outline:none}
@media(max-width:900px){.main{grid-template-columns:1fr}.left,.rightSide{display:none}}
</style>
</head>
<body>

<header>
<div style="display:flex;align-items:center;gap:10px"><div class="logo">gmmconnect</div><div class="search"><i class="fa fa-search"></i><input placeholder="Search GMM Connect"></div></div>
<div class="nav-mid"><i class="fa-solid fa-house active"></i><i class="fa-solid fa-tv"></i><i class="fa-solid fa-store"></i><i class="fa-solid fa-users"></i></div>
<div class="right"><i class="fa-solid fa-plus"></i><i class="fa-brands fa-facebook-messenger" onclick="toggleChat()"></i><i class="fa-solid fa-bell"></i><img id="navPic" style="width:40px;height:40px;border-radius:50%;cursor:pointer"></div>
</header>

<div id="loginScreen">
<div class="login-box">
<h1>gmmconnect</h1>
<p style="font-size:18px;margin-bottom:20px">Connect with friends and the world around you on GMM Connect.</p>
<button class="btn" onclick="login()"><i class="fa-brands fa-google"></i> Continue with Google</button>
<p style="margin-top:15px;font-size:12px;color:#777">Your Firebase is connected: gmmconnect01</p>
</div>
</div>

<div class="main">
<div class="left">
<div class="card"><div style="display:flex;gap:10px;align-items:center"><img id="sidePic" style="width:35px;height:35px;border-radius:50%"><b id="sideName"></b></div><br><p><i class="fa-solid fa-user-group"></i> Friends</p><br><p><i class="fa-solid fa-clock-rotate-left"></i> Memories</p><br><p><i class="fa-solid fa-bookmark"></i> Saved</p></div>
</div>

<div class="center">
<div class="card create"><img id="createPic"><input id="postText" placeholder="What's on your mind?" onclick="document.getElementById('postModal').style.display='block'"></div>
<div id="feed"></div>
</div>

<div class="rightSide">
<div class="card"><b>Contacts</b><div id="contacts" style="margin-top:10px"></div></div>
</div>
</div>

<div class="chat-box" id="chatBox">
<div class="chat-head"><span>Messenger</span><span onclick="toggleChat()" style="cursor:pointer"><i class="fa fa-xmark"></i></span></div>
<div class="messages" id="chatMessages"></div>
<div class="chat-input"><input id="chatInput" placeholder="Aa" onkeypress="if(event.key==='Enter')sendMsg()"><i class="fa-solid fa-paper-plane" style="padding:10px;color:#0084ff;cursor:pointer" onclick="sendMsg()"></i></div>
</div>

<div id="postModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:300;align-items:center;justify-content:center">
<div class="card" style="width:90%;max-width:500px;margin:10% auto">
<div style="display:flex;justify-content:space-between"><h3>Create Post</h3><i class="fa fa-xmark" onclick="this.parentElement.parentElement.parentElement.style.display='none'" style="cursor:pointer"></i></div>
<textarea id="modalText" placeholder="What's on your mind?" style="width:100%;height:100px;border:none;background:#f0f2f5;border-radius:10px;padding:10px;margin:15px 0;outline:none"></textarea>
<input type="file" id="imgFile" accept="image/*"><br>
<button class="btn" onclick="createPost()">Post</button>
</div>
</div>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyB5CE1LNky6HkqDn4uLHPVScILlz-NPIws",
  authDomain: "gmmconnect01.firebaseapp.com",
  databaseURL: "https://gmmconnect01-default-rtdb.firebaseio.com",
  projectId: "gmmconnect01",
  storageBucket: "gmmconnect01.firebasestorage.app",
  messagingSenderId: "1079348259443",
  appId: "1:1079348259443:web:d277772f63b980f8fc9806"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.database();
let currentUser=null;

function login(){
 const provider = new firebase.auth.GoogleAuthProvider();
 auth.signInWithPopup(provider).then(r=>{currentUser=r.user;init()});
}
auth.onAuthStateChanged(u=>{if(u){currentUser=u;init()}});

function init(){
 document.getElementById('loginScreen').style.display='none';
 document.getElementById('navPic').src=currentUser.photoURL;
 document.getElementById('sidePic').src=currentUser.photoURL;
 document.getElementById('createPic').src=currentUser.photoURL;
 document.getElementById('sideName').innerText=currentUser.displayName;
 loadPosts(); loadChat();
 db.ref('users/'+currentUser.uid).set({name:currentUser.displayName,photo:currentUser.photoURL,online:true});
 loadUsers();
}

function createPost(){
 const text=document.getElementById('modalText').value;
 const file=document.getElementById('imgFile').files[0];
 if(!text &&!file) return alert('Write something');
 const postId=Date.now();
 if(file){
   // simple: upload to firebase storage is blocked in your rules, so we use base64 for now
   const reader=new FileReader();
   reader.onload=e=>{
     db.ref('posts/'+postId).set({uid:currentUser.uid,name:currentUser.displayName,photo:currentUser.photoURL,text,img:e.target.result,time:Date.now()});
     document.getElementById('postModal').style.display='none';
   }; reader.readAsDataURL(file);
 }else{
   db.ref('posts/'+postId).set({uid:currentUser.uid,name:currentUser.displayName,photo:currentUser.photoURL,text,img:'',time:Date.now()});
   document.getElementById('postModal').style.display='none';
 }
 document.getElementById('modalText').value='';
}

function loadPosts(){
 db.ref('posts').on('value',snap=>{
   const feed=document.getElementById('feed'); feed.innerHTML='';
   const data=snap.val(); if(!data) return;
   Object.values(data).sort((a,b)=>b.time-a.time).forEach(p=>{
     feed.innerHTML+=`<div class="card"><div class="post-head"><img src="${p.photo}"><div><b>${p.name}</b><br><small style="color:#65676b">${new Date(p.time).toLocaleString()}</small></div></div><p>${p.text||''}</p>${p.img?`<img src="${p.img}" class="feed-img">`:''}<div class="post-actions"><span><i class="fa-regular fa-thumbs-up"></i> Like</span><span><i class="fa-regular fa-comment"></i> Comment</span><span onclick="toggleChat()"><i class="fa-solid fa-share"></i> Message</span></div></div>`;
   });
 });
}

function toggleChat(){const b=document.getElementById('chatBox');b.style.display=b.style.display==='flex'?'none':'flex';}
function sendMsg(){
 const t=document.getElementById('chatInput').value; if(!t) return;
 db.ref('chats').push({uid:currentUser.uid,name:currentUser.displayName,text:t,time:Date.now()});
 document.getElementById('chatInput').value='';
}
function loadChat(){
 db.ref('chats').limitToLast(50).on('value',snap=>{
   const m=document.getElementById('chatMessages'); m.innerHTML='';
   const d=snap.val(); if(!d) return;
   Object.values(d).forEach(c=>{
     const isMe=currentUser && c.uid===currentUser.uid;
     m.innerHTML+=`<div class="msg ${isMe?'me':''}"><small>${isMe?'You':c.name}</small><br>${c.text}</div>`;
   }); m.scrollTop=m.scrollHeight;
 });
}
function loadUsers(){
 db.ref('users').on('value',s=>{
   const c=document.getElementById('contacts'); c.innerHTML='';
   const u=s.val(); if(!u) return;
   Object.values(u).forEach(x=>{c.innerHTML+=`<div style="display:flex;gap:8px;align-items:center;margin:8px 0"><img src="${x.photo}" style="width:30px;height:30px;border-radius:50%"><span>${x.name}</span><span style="width:8px;height:8px;background:green;border-radius:50%;margin-left:auto"></span></div>`});
 });
}
</script>
</body>
</html>
